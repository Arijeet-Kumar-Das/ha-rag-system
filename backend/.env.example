PORT=5000
MONGO_URI=your_mongo_uri
JWT_SECRET=your_secret_key
OPENAI_API_KEY=your_key_here
PINECONE_API_KEY=your_key_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
BACKEND_URL=https://your-render-backend-url.onrender.com
# OCR Configuration (all optional — sensible defaults are built in)
OCR_LANGUAGE=eng
OCR_TEXT_THRESHOLD=50
OCR_DENSITY_THRESHOLD=0.005
OCR_RENDER_SCALE=2.0
# Figure Understanding (Phase 2)
FIGURE_UNDERSTANDING_ENABLED=false
VISION_MODEL=gpt-4o-mini
FIGURE_MIN_DIMENSION=100
FIGURE_MIN_AREA_RATIO=0.02
FIGURE_MAX_PER_PAGE=10
# Table Understanding (Phase 3)
TABLE_UNDERSTANDING_ENABLED=false
# Conversational Memory (Query Rewriting)
CHAT_HISTORY_LIMIT=10
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_LLM_ENABLED=true
LLM_HISTORY_MESSAGES=5